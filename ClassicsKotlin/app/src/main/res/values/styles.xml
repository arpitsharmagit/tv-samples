<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Leanback">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="playbackControlsAutoHideTickleTimeout">10000</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Dialog theme for update dialog - optimized for TV navigation -->
    <style name="AppTheme.Dialog" parent="Theme.Leanback">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowMinWidthMajor">50%</item>
        <item name="android:windowMinWidthMinor">50%</item>
        <!-- Enhanced TV navigation properties -->
        <item name="android:colorControlHighlight">@color/colorAccent</item>
        <item name="android:colorFocusedHighlight">@color/colorAccent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorControlActivated">@color/colorAccent</item>
        <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>
    
    <!-- Button style for TV navigation -->
    <style name="TvButton" parent="Widget.AppCompat.Button">
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:padding">12dp</item>
    </style>

</resources>

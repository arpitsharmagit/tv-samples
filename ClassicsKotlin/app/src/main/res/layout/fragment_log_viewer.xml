<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <Spinner
            android:id="@+id/logLevelSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:nextFocusRight="@+id/decreaseFontButton"
            android:nextFocusDown="@+id/logTextView"
            android:focusable="true"
            android:focusableInTouchMode="true"/>

        <androidx.leanback.widget.ImageCardView
            android:id="@+id/increaseFontButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/decreaseFontButton"
            android:nextFocusRight="@+id/clearLogsButton"
            android:clickable="true"
            android:background="@android:color/transparent"
            style="@style/Widget.Leanback.ImageCardViewStyle"/>

        <androidx.leanback.widget.ImageCardView
            android:id="@+id/decreaseFontButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/logLevelSpinner"
            android:nextFocusRight="@+id/increaseFontButton"
            android:clickable="true"
            style="@style/Widget.Leanback.ImageCardViewStyle"/>

        <androidx.leanback.widget.ImageCardView
            android:id="@+id/clearLogsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/increaseFontButton"
            android:nextFocusDown="@+id/logTextView"
            android:clickable="true"
            style="@style/Widget.Leanback.ImageCardViewStyle"/></LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay">

        <TextView
        android:id="@+id/logTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:textSize="12sp"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:background="@android:color/black"
        android:textColor="@android:color/white"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/logLevelSpinner"/>

    </ScrollView>

</LinearLayout>